OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# Browser source storage. This is the public key, not a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Study-note worker: server-only credentials and local Redis.
SUPABASE_SECRET_KEY=replace-me
REDIS_URL=redis://127.0.0.1:6379/0

# On-demand research uses the server-only OPENAI_API_KEY above.

# Web retrieval indexing uses hosted Qdrant. Server-only.
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace-me
# Enable background dispatch only after migration and named-source acceptance.
ENABLE_RETRIEVAL_INDEXING=false
# Hybrid assistant queries require migration 014 and separate acceptance first.
ENABLE_HYBRID_RETRIEVAL=false

# Development evaluator: dedicated learner session, never a service-role key.
EVAL_SESSION_TOKEN=replace-me

# Path quiz (server-only; never exposed to the browser). Defaults shown; hard maxima are enforced in code.
# QUIZ_ENABLED is a spend switch: false blocks only quiz generation and AI feedback; a stored quiz stays takeable.
QUIZ_ENABLED=true
QUIZ_MAX_QUESTIONS=8
QUIZ_MAX_SHORT_ANSWER=2
QUIZ_GENERATIONS_PER_USER_PER_DAY=3
QUIZ_GRADINGS_PER_USER_PER_DAY=20
# Raise to at least 6000 when QUIZ_MAX_QUESTIONS is above 8 (a warning is logged below 350 x QUIZ_MAX_QUESTIONS).
QUIZ_MAX_OUTPUT_TOKENS=4000
QUIZ_GRADING_MAX_OUTPUT_TOKENS=800
QUIZ_SHORT_ANSWER_MAX_CHARS=1500
QUIZ_GENERATION_MODEL=gpt-6-luna
# Generation only, used after a completed-but-invalid Luna output survived one repair.
QUIZ_FALLBACK_MODEL=gpt-6.1-sol
# Short-answer feedback has no fallback rung; set this to gpt-6.1-sol to opt in to a stronger grader.
QUIZ_GRADING_MODEL=gpt-6-luna
QUIZ_REASONING_EFFORT=low
